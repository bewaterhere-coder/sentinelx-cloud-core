+def _verify_sealed_entries(root: Path, entries: tuple[FileDigestEntry, ...]) -> None:
+    """Revalidate sealed inputs while allowing generated workspace outputs."""
+    canonical_root = root.resolve(strict=True)
+    if _is_reparse_or_symlink(canonical_root):
+        raise ValueError("materialized verification root must not be a reparse point")
+    for entry in entries:
+        cursor = canonical_root
+        for part in entry.path.split("/"):
+            cursor = cursor / part
+            if not cursor.exists() or _is_reparse_or_symlink(cursor):
+                raise ValueError("sealed verification input is missing or traverses a reparse point")
+        item = cursor.resolve(strict=True)
+        if not item.is_relative_to(canonical_root) or not item.is_file():
+            raise ValueError("sealed verification input escaped the materialized source")
+        if item.stat().st_size != entry.size or _sha256_file(item) != entry.sha256:
+            raise ValueError("sealed verification input changed during execution")
+
