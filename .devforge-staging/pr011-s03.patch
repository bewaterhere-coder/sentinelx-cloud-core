+def test_verification_rejects_caller_network_and_npm_authority(tmp_path: Path) -> None:
+    _profile, handler, context, store, record, mutation, lineage, repo, verification = _fixture(tmp_path)
+    with pytest.raises(Exception) as exc_info:
+        asyncio.run(
+            handler(
+                context,
+                {
+                    "interpreter": "python3",
+                    "content": "print('must-not-run')",
+                    "timeout": 30,
+                    "env": {"HTTP_PROXY": "http://caller", "NPM_CONFIG_REGISTRY": "https://caller"},
+                    "mutation": mutation,
+                    "lineage": lineage,
+                    "repository": repo,
+                    "verification": verification,
+                },
+            )
+        )
+    assert getattr(exc_info.value, "code", None) == "HostMutationSandboxBindingMismatch"
