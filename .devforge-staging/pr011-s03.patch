+    """Prove sealed verification inputs survived execution unchanged.
+
+    Runtime-generated files such as node_modules and npm cache entries are
+    allowed inside the exact workspace; only provider-sealed source members,
+    package-lock identity, toolchain identity and launcher identity are
+    authoritative post-run inputs.
+    """
+    plan = materialized.plan
+    current_toolchain = build_toolchain_manifest(plan.profile)
+    if not _same_toolchain(current_toolchain, plan.toolchain):
+        raise ValueError("verification toolchain changed during execution")
+    _verify_sealed_entries(materialized.source_root, plan.admission.source.files)
+    _assert_lock(
+        materialized.source_root / "package-lock.json",
+        plan.admission.expected_package_lock_sha256,
