+def test_real_offline_node_npm_runs_through_sealed_shims(tmp_path: Path, monkeypatch) -> None:
+    profile, handler, context, store, record, mutation, lineage, repo, verification = _fixture(tmp_path)
+    monkeypatch.setenv("HTTP_PROXY", "http://127.0.0.1:9")
+    monkeypatch.setenv("GITHUB_TOKEN", "must-not-inherit")
+    content = """
+import os, subprocess
+
+def run(command):
+    result = subprocess.run(command, shell=True, text=True, capture_output=True, check=True)
+    print(result.stdout.strip())
+
+run('node --version')
+run('npm --version')
+run('npm ci --offline --ignore-scripts --no-audit --no-fund')
+run('npm run verify --offline --no-audit --no-fund')
+print('http_proxy=' + str(os.environ.get('HTTP_PROXY')))
+print('github_token=' + str(os.environ.get('GITHUB_TOKEN')))
+print('npm_offline=' + str(os.environ.get('NPM_CONFIG_OFFLINE')))
+"""
+    result = asyncio.run(
+        handler(
+            context,
+            {
+                "interpreter": "python3",
+                "content": content,
+                "timeout": 120,
+                "cleanup": True,
+                "mutation": mutation,
+                "lineage": lineage,
+                "repository": repo,
+                "verification": verification,
+            },
+        )
+    )
+    assert result["ok"] is True
+    assert result["cwd"] == "."
+    assert "offline-ok" in result["output"]
+    assert "http_proxy=None" in result["output"]
+    assert "github_token=None" in result["output"]
+    assert "npm_offline=true" in result["output"]
+    assert "command" not in result and "workdir" not in result and "script_path" not in result
+    assert result["verification"]["profile"] == "node_npm"
+    assert result["verification"]["offline"] is True
+    assert result["verification"]["network_mode"] == "none"
+    assert store.read_scope(record.scope_id).state == "terminal"
+
+    events = MutationAuditJournal(store.root.parent, evidence_retention_days=7).read_events(
+        result["audit_operation_id"]
+    )
+    assert [event["event"] for event in events] == [EVENT_STARTED, EVENT_SPAWNED, EVENT_FINISHED]
+    assert events[0]["verification_intent"]["network_mode"] == "none"
+    assert events[1]["containment"]["breakaway_allowed"] is False
+    assert events[2]["closure"]["process_tree_quiescent"] is True
+    sandbox_sid = events[0]["requested_identity"]["sandbox_identity"]
+    assert all(sid != sandbox_sid for sid, _mask, _flags in _dacl_entries(profile.toolchain_root))
+
